# 複製成 .env 後填寫。.env 已列入 .gitignore，不要 commit。

# Tailscale：第一次啟動 sidecar 時可填 auth key（無 tag、非 reusable、非 ephemeral）。
# 留空則從 `docker compose logs ts` 取得登入網址。登入成功後可清空。
TS_AUTHKEY=
# 對外網址，`docker compose exec ts tailscale funnel status` 會顯示。
PUBLIC_BASE_URL=https://trip-split.<tailnet>.ts.net
TZ=Asia/Taipei

# 管理頁 /admin 的密碼。
ADMIN_PASSWORD=
# JWT 簽章金鑰；留空會自動產生在 data/.app_secret。
APP_SECRET=

# LINE Messaging API channel（官方帳號）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 你的 LINE userId，私訊官方帳號「我的ID」取得。可管理所有帳本。
LINE_ADMIN_USER_ID=

# LINE Login channel 與 LIFF（需和 Messaging API channel 在同一個 provider）
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# Gemini（選填；沒有時只支援快速格式記帳，不能讀收據）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_S=25
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
TRIP_SUMMARY_PUSH=false
